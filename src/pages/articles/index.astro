---
/* The archive hub. Without it a post was reachable only from the homepage grid
   and had nowhere to link back to — a dead end for both readers and crawlers. */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { blogIndexSchema } from '../../data/schema';
import { PERSON, absoluteUrl } from '../../data/identity';
import portrait from '../../assets/portrait.png';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const sorted = articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const description =
    'Essays by Gabriele Bolognese on building FlashFX, motion design, and founding a software company solo.';

const schema = blogIndexSchema({
    path: Astro.url.pathname,
    portraitUrl: absoluteUrl(portrait.src, Astro.site),
    posts: sorted.map(article => ({
        title: article.data.title,
        description: article.data.description,
        path: `/articles/${article.id}`,
        published: article.data.date,
    })),
});
---
<Layout
        title={`Articles — ${PERSON.name}`}
        description={description}
        schema={schema}
>

<nav class="nav" aria-label="Site navigation">
    <a href="/" class="nav-name">Gabriele Bolognese</a>
    <ul class="nav-links">
        <li><a href="/about">About</a></li>
        <li><a href="/#projects">Projects</a></li>
        <li><a href="/articles">Articles</a></li>
        <li><a href="/#contact">Contact</a></li>
    </ul>
</nav>

<main id="main">
    <section class="section" aria-labelledby="articles-heading">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-current="page">Articles</li>
            </ol>
        </nav>

        <h1 id="articles-heading" class="section-label">Articles</h1>
        <p class="section-intro">{description}</p>

        {sorted.length === 0 ? (
            <p class="section-intro">Nothing published yet — the first post is on its way.</p>
        ) : (
            <div class="articles-grid">
                {sorted.map(article => (
                    <Card
                        title={article.data.title}
                        description={article.data.description}
                        image={article.data.image}
                        imageAlt={article.data.imageAlt}
                        slug={article.id}
                        date={article.data.date}
                    />
                ))}
            </div>
        )}
    </section>
</main>

<footer class="footer">
    <div class="footer-inner">
        <span>© 2026 Gabriele Bolognese</span>
        <span class="dot">·</span>
        <a href="/about">About</a>
        <span class="dot">·</span>
        <a href="/rss.xml">RSS</a>
        <span class="dot">·</span>
        <a href="https://flashfx.app" target="_blank" rel="noopener noreferrer">flashfx.app</a>
    </div>
</footer>

</Layout>

<style>
    .breadcrumb ol {
        display: flex;
        gap: 10px;
        list-style: none;
        margin: 0 0 32px;
        padding: 0;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    .breadcrumb li + li::before {
        content: '/';
        margin-right: 10px;
        color: var(--gray-line);
    }

    .breadcrumb a { color: var(--gray-dark); }
    .breadcrumb a:hover { color: var(--black); }
</style>
