---
/* /editing: the video editing portfolio.

   The pieces are data (src/data/editing.ts), the files come from
   scripts/encode-editing.mjs, each card is ReelCard.astro, and this page only
   orders them: short form in one row per category, then long form, then the
   experience, the process and the offer. Grid and card styles are
   "26. EDITING PORTFOLIO" in Style.css; playback is initReels() in motion.js.

   How the videos load, which is most of what this page is about:

   - Nothing downloads until someone shows intent. preload="none", so the
     first paint costs one small WebP poster per card and zero video bytes.
   - Intent warms the buffer. Hovering a card for a moment, or focusing it,
     flips preload to "auto" (initReels), so by the time the click lands the
     first seconds are already local and playback starts at once.
   - The browser picks the cheapest file it can decode. AV1 is offered first
     with an exact codecs string, H.264 second, and a browser without AV1
     rejects that source from the type alone, without fetching it.
   - Same origin, no player library, no iframe. Nothing new for the CSP to
     allow: media-src falls back to default-src 'self'.
   - Native controls, so it all still works with JavaScript off. */
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ReelCard from '../components/ReelCard.astro';
import { PERSON, EDITING, absoluteUrl } from '../data/identity';
import { PORTRAIT, posterWidth, schemaImageUrl } from '../data/images';
import { editingSchema } from '../data/schema';
import {
  resolveReels,
  clock,
  isoDuration,
  CATEGORY_LABEL,
  SHORT_CATEGORIES,
  PROCESS,
} from '../data/editing';
import portrait from '../assets/gabriele-bolognese-portrait.png';

const reels = await Promise.all(
  resolveReels().map(async (reel) => ({
    ...reel,
    posterUrl: (await getImage({ src: reel.poster, width: posterWidth(reel), format: 'webp' })).src,
  })),
);

const shortRows = SHORT_CATEGORIES
  .map((category) => ({
    category,
    label: CATEGORY_LABEL[category],
    reels: reels.filter((reel) => reel.format === 'short' && reel.category === category),
  }))
  .filter((row) => row.reels.length > 0);
const longForm = reels.filter((reel) => reel.format === 'long');

/** Length of the work, not of what is published: an excerpt counts in full. */
const runtime = reels.reduce((total, reel) => total + reel.sourceDuration, 0);

/** Derived at build time, so the line is still true next year. */
const years = new Date().getFullYear() - EDITING.freelanceSince;
const adsFor = new Intl.ListFormat('en', { type: 'conjunction' }).format(EDITING.adsFor);

const schema = editingSchema({
  path: Astro.url.pathname,
  portraitUrl: await schemaImageUrl(portrait, PORTRAIT, Astro.site),
  videos: reels.map((reel) => ({
    slug: reel.slug,
    name: reel.title,
    description: reel.summary ?? `${reel.kind}, edited by ${PERSON.name}.`,
    thumbnailUrl: absoluteUrl(reel.posterUrl, Astro.site),
    // The H.264 file, not the AV1 one: contentUrl is fetched by crawlers
    // that may not decode AV1, and it is the one every browser can play.
    contentUrl: absoluteUrl(reel.sources[reel.sources.length - 1].src, Astro.site),
    uploadDate: reel.date,
    duration: isoDuration(reel.duration),
    width: reel.width,
    height: reel.height,
  })),
});

const mailto = `mailto:${PERSON.email}?subject=${encodeURIComponent('Free test video')}`;
---
<Layout title={`${EDITING.title}, ${PERSON.name}`} description={EDITING.description} schema={schema}>

<Nav />

<main id="main">
    <section class="section" aria-labelledby="editing-heading">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-current="page">{EDITING.name}</li>
            </ol>
        </nav>

        <h1 id="editing-heading" class="editing-h1">{EDITING.name}</h1>
        <p class="editing-intro">{EDITING.description}</p>

        <p class="editing-stat">
            <strong>{reels.length}</strong> {reels.length === 1 ? 'edit' : 'edits'}
            <span class="dot">·</span>
            <strong>{clock(runtime)}</strong> of runtime
            <span class="dot">·</span>
            editing since <strong>{EDITING.since}</strong>
        </p>

        <h2 id="short-form" class="section-label editing-h2">Short form</h2>
        {shortRows.map((row) => (
            <div class="reel-row" aria-labelledby={`row-${row.category}`}>
                <h3 id={`row-${row.category}`} class="reel-row-title">
                    {row.label} <span>{row.reels.length}</span>
                </h3>
                <ul class="reel-grid">
                    {row.reels.map((reel) => <ReelCard reel={reel} level={4} />)}
                </ul>
            </div>
        ))}

        {longForm.length > 0 && (
            <>
                <h2 id="long-form" class="section-label editing-h2">Long form</h2>
                <ul class="reel-grid reel-grid--long">
                    {longForm.map((reel) => <ReelCard reel={reel} level={3} />)}
                </ul>
            </>
        )}
    </section>

    <div class="rule"></div>

    <section class="section" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="section-label">Experience</h2>
        <div class="editing-prose">
            <p>
                I have spent <strong>{years} years</strong> editing for multiple channels, both
                clients’ and my own, and along the way built an extensive knowledge of many styles.
            </p>
            <p>
                I have also managed ads for {adsFor}.
            </p>
        </div>
    </section>

    <div class="rule"></div>

    <section class="section" aria-labelledby="process-heading">
        <h2 id="process-heading" class="section-label">Process</h2>
        <p class="section-intro">How a video goes from the first message to the final export.</p>
        <ol class="process">
            {PROCESS.map((step, i) => (
                <li class="process-step">
                    <span class="process-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <h3 class="process-title">{step.title}</h3>
                    <p class="process-text">{step.text}</p>
                </li>
            ))}
        </ol>
    </section>

    <div class="rule"></div>

    <section class="section editing-cta" aria-labelledby="editing-cta-heading">
        <h2 id="editing-cta-heading" class="section-label">Work with me</h2>
        <div class="editing-prose">
            <p>
                These are not the only styles I can do. If the one you need is not on this page, I
                will make you a video in it for free, so you can test my skills on your own kind of
                content first.
            </p>
        </div>
        <a class="next-btn" href={mailto}>Ask for a free test video</a>
    </section>
</main>

<footer class="footer">
    <div class="footer-inner">
        <span>© 2026 Gabriele Bolognese</span>
        <span class="dot">·</span>
        <a href="/license/">Image licence</a>
        <span class="dot">·</span>
        <a href="/about/">About</a>
        <span class="dot">·</span>
        <a href="/newsletter/">Newsletter</a>
        <span class="dot">·</span>
        <a href="https://flashfx.app" target="_blank" rel="noopener noreferrer">flashfx.app</a>
    </div>
</footer>

</Layout>

<style>
    .breadcrumb ol {
        display: flex;
        gap: 10px;
        list-style: none;
        margin: 0 0 32px;
        padding: 0;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    .breadcrumb li + li::before {
        content: '/';
        margin-right: 10px;
        color: var(--gray-line);
    }

    .breadcrumb a { color: var(--gray-dark); }
    .breadcrumb a:hover { color: var(--black); }
</style>
