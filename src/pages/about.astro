---
/* Replaces public/story.html, which was indexable, orphaned, entirely unstyled,
   and canonicalised to flashfx.app — telling Google to credit another domain for
   1,000 words of biography hosted here. Same prose, now a first-class page:
   self-canonical, styled, and linked from the nav and footer. */
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import LifeGrid from '../components/LifeGrid.astro';
import { aboutPageSchema } from '../data/schema';
import { HOMEPAGE_FAQ } from '../data/faq';
import { PERSON, FACTS, SAME_AS, absoluteUrl } from '../data/identity';
import portrait from '../assets/portrait.png';
import imgVision from '../assets/1010.png';
import imgPivot from '../assets/1111.png';
import imgSubmission from '../assets/111.png';

const title = 'Who is Gabriele Bolognese? — Founder of FlashFX';
const description =
    'The full biography of Gabriele Bolognese: Italian founder of FlashFX, from a hacked Minecraft channel in 2020 to a browser-based motion graphics platform.';

const schema = aboutPageSchema({
    portraitUrl: absoluteUrl(portrait.src, Astro.site),
    path: Astro.url.pathname,
    // No FAQPage node here on purpose: the homepage already owns that entity,
    // and the same FAQPage on two indexable URLs is what made story.html and
    // the homepage compete with each other in the first place. The questions
    // are still rendered below — useful to readers and to answer engines,
    // which extract visible Q&A regardless of markup.
    faq: [],
});

/** Human label for a profile URL, so the link list reads as prose. */
function labelFor(url: string): string {
    const host = new URL(url).hostname.replace(/^www\./, '');
    const map: Record<string, string> = {
        'linkedin.com': 'LinkedIn',
        'github.com': 'GitHub',
        'youtube.com': 'YouTube',
        'instagram.com': 'Instagram',
        'producthunt.com': 'Product Hunt',
        'peerlist.io': 'Peerlist',
        'connectively.us': 'Connectively',
        'x.com': 'X',
    };
    return map[host] ?? host;
}

/* ── Age and life grid, computed at build time ───────────────────────────────
   Both are rendered complete and correct in the HTML rather than drawn by JS on
   load, so a no-JS visitor sees real figures and there is no layout shift.
   motion.js then reconciles the drift since the last deploy. */

const BIRTH = new Date(PERSON.birthDateTime);
const NOW = new Date();

/** Whole calendar days between two dates — ms division drifts across DST. */
function calendarDays(from: Date, to: Date): number {
    const a = Date.UTC(from.getFullYear(), from.getMonth(), from.getDate());
    const b = Date.UTC(to.getFullYear(), to.getMonth(), to.getDate());
    return Math.round((b - a) / 86_400_000);
}

function ageAt(now: Date) {
    let years = now.getFullYear() - BIRTH.getFullYear();
    let mark = new Date(BIRTH.getTime());
    mark.setFullYear(BIRTH.getFullYear() + years);
    if (mark.getTime() > now.getTime()) {
        years -= 1;
        mark = new Date(BIRTH.getTime());
        mark.setFullYear(BIRTH.getFullYear() + years);
    }
    let days = calendarDays(mark, now);
    const secsIn = (d: Date) => d.getHours() * 3600 + d.getMinutes() * 60 + d.getSeconds();
    let delta = secsIn(now) - secsIn(BIRTH);
    if (delta < 0) { delta += 86_400; days -= 1; }
    return {
        years,
        days,
        hours: Math.floor(delta / 3600),
        mins: Math.floor((delta % 3600) / 60),
        secs: delta % 60,
    };
}

const age = ageAt(NOW);
const pad = (n: number) => String(n).padStart(2, '0');

/* The Tim Urban "life in weeks" grid: 52 columns, 90 rows, one square a week. */
const WEEK_COLUMNS = 52;
const LIFE_ROWS = 90;
const TOTAL_WEEKS = WEEK_COLUMNS * LIFE_ROWS;
const weeksLived = Math.min(
    TOTAL_WEEKS,
    Math.max(0, Math.floor((NOW.getTime() - BIRTH.getTime()) / 604_800_000)),
);
const livedPercent = ((weeksLived / TOTAL_WEEKS) * 100).toFixed(1);

const ventures = [
    { year: '2020–2022', project: 'YouTube channel playmoj', outcome: 'Terminated following account compromise' },
    { year: '2022–2023', project: 'Freelance editing via Fiverr (Emerals)', outcome: '$1,200 total earnings; client concluded operations' },
    { year: '2024', project: 'Vision AI Demo', outcome: 'Lost to development error; €200 debt' },
    { year: '2024', project: 'Five browser-based tool prototypes', outcome: 'None reached functional release' },
    { year: '2025–present', project: 'FlashFX', outcome: 'Active; V1 launched early 2026' },
];
---
<Layout title={title} description={description} type="profile" schema={schema}>

<nav class="nav" aria-label="Site navigation">
    <a href="/" class="nav-name">Gabriele Bolognese</a>
    <ul class="nav-links">
        <li><a href="/about">About</a></li>
        <li><a href="/#projects">Projects</a></li>
        <li><a href="/articles">Articles</a></li>
        <li><a href="/#contact">Contact</a></li>
    </ul>
</nav>

<main id="main">
    <article class="section bio">

        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-current="page">About</li>
            </ol>
        </nav>

        <header class="bio-header">
            <h1 class="bio-h1">Who is Gabriele Bolognese?</h1>
            <p class="bio-standfirst">
                Italian founder and lead developer of
                <a href="https://flashfx.app" target="_blank" rel="noopener noreferrer">FlashFX</a> —
                from a hacked Minecraft channel in 2020 to a browser-based motion graphics and video
                editing platform used by over {FACTS.usersLabel} people.
            </p>

            {/* Count-up, the mirror of the homepage countdown. Rendered with real
                values at build time; motion.js takes over once it loads. */}
            <div class="age" data-birth={PERSON.birthDateTime}>
                <span class="age-label">Alive for</span>
                <div class="age-display">
                    <div class="age-unit">
                        <span class="age-num" id="age-years">{age.years}</span>
                        <span class="age-unit-label">Years</span>
                    </div>
                    <span class="age-sep">.</span>
                    <div class="age-unit">
                        <span class="age-num" id="age-days">{age.days}</span>
                        <span class="age-unit-label">Days</span>
                    </div>
                    <span class="age-sep">.</span>
                    <div class="age-unit">
                        <span class="age-num" id="age-hours">{pad(age.hours)}</span>
                        <span class="age-unit-label">Hours</span>
                    </div>
                </div>
                <p class="age-sub">
                    and <span id="age-mins">{pad(age.mins)}</span> minutes,
                    <span id="age-secs">{pad(age.secs)}</span> seconds —
                    since <time datetime={PERSON.birthDate}>6 December 2008</time>
                </p>
            </div>
        </header>

        <div class="bio-split">
            <aside class="bio-side">
                <Image
                    src={portrait}
                    alt="Gabriele Bolognese, founder of FlashFX"
                    class="bio-portrait"
                    widths={[320, 640]}
                    sizes="(max-width: 900px) 100vw, 340px"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />

                <h2 class="bio-side-heading">About</h2>
                <p class="bio-lede">
                    <strong>Gabriele Bolognese</strong> (born 6 December 2008) is an Italian software
                    developer, entrepreneur, and content creator, best known as the founder and chief
                    executive officer of FlashFX, a browser-based motion design and video editing
                    application. He began teaching himself video production at the age of eleven and later
                    moved into freelance editing and independent software development, founding FlashFX
                    without formal training in computer science.
                </p>
            </aside>

            <section class="bio-panel" aria-labelledby="life-heading">
                <h2 id="life-heading" class="bio-side-heading">Life in weeks</h2>
                <p class="life-intro">
                    One square is one week. Ninety years, {TOTAL_WEEKS.toLocaleString()} of them.
                </p>
                <LifeGrid
                    birth={PERSON.birthDateTime}
                    weeksLived={weeksLived}
                    totalWeeks={TOTAL_WEEKS}
                />

                <p class="life-caption">
                    <strong id="life-count">{weeksLived.toLocaleString()}</strong> weeks lived ·
                    <strong id="life-percent">{livedPercent}%</strong>
                </p>

                <ul class="life-key">
                    <li><i class="is-lived" aria-hidden="true"></i> Lived</li>
                    <li><i class="is-now" aria-hidden="true"></i> This week</li>
                    <li><i aria-hidden="true"></i> Ahead</li>
                </ul>
            </section>
        </div>

        <h2 id="early-life">Early life and education</h2>
        <p>
            Bolognese was born in December 2008 in Italy and grew up in the Veneto region. He attended
            secondary school locally, later enrolling at IIS Viola Marchesini. His academic trajectory was
            intermittently disrupted by professional and entrepreneurial activity pursued in parallel with
            formal studies, including a failed academic year in 2025 that required a supplementary recovery
            examination before progression to the subsequent grade.
        </p>
        <p>
            Outside the classroom, he practiced karate competitively throughout his adolescence, a commitment
            he maintained with varying consistency depending on workload. Extended periods of intensive
            software development led to prolonged interruptions in training during 2025.
        </p>
        <p>
            Bolognese is self-taught across all of his primary professional disciplines. He acquired English
            predominantly through exposure to online content between the ages of eleven and thirteen, without
            formal instruction. His programming knowledge, spanning JavaScript, TypeScript, and React, was
            developed through independent study beginning in late December 2024.
        </p>

        <h2 id="career">Career</h2>

        <h3 id="content-creation">Content creation (2020–2022)</h3>
        <p>
            During the COVID-19 pandemic lockdowns of 2020, at the age of eleven, Bolognese began publishing
            Minecraft gameplay videos on YouTube under the channel name <em>playmoj</em>. Operating on
            consumer-grade hardware, he taught himself video editing through Shotcut and later CapCut,
            publishing content at an average rate of one to four videos per day. The channel accumulated
            approximately 1,560 subscribers across more than 600 uploads before being compromised in 2022 by a
            third-party service that deleted all published content and repurposed the account for fraudulent
            activity. The incident ended his activity as a content creator.
        </p>

        <h3 id="freelance-editing">Freelance video editing (2022–2025)</h3>
        <p>
            At the age of fourteen, Bolognese created a profile on the freelance platform Fiverr, motivated
            initially by the need to fund a personal hardware purchase. He secured his first client, a
            GTA-themed YouTube channel called Emerals, through outreach from a user identified online by the
            alias <em>hansa</em>. Initial compensation was five dollars per edited video, rising incrementally
            to twenty dollars over the course of the six-month engagement. Total earnings from the contract
            amounted to approximately $1,200.
        </p>
        <p>
            Following the conclusion of that contract in mid-2023, subsequent Fiverr listings produced no
            clients for several months. Bolognese returned to freelance editing intermittently through 2024
            and into 2025, when a client in the financial content niche commissioned monthly video packages at
            $250 per month. The arrangement was terminated after five deliverables, following persistent delays
            and extensive revision cycles that he has publicly attributed to concurrent overcommitment across
            editing, software development, and academic obligations.
        </p>

        <h3 id="software-development">Software development and entrepreneurship (2024–present)</h3>

        <figure class="bio-figure">
            <Image src={imgVision} alt="The Vision AI Demo browser-based video editor, 2024"
                   widths={[480, 960]} sizes="(max-width: 860px) 100vw, 720px" loading="lazy" decoding="async" />
            <figcaption>2024 — Vision AI Demo, the first attempt</figcaption>
        </figure>

        <p>
            Bolognese's interest in software development emerged indirectly through exposure to AI-powered
            content automation tools in late 2023. On January 3, 2024, he began his first development project,
            a browser-based video editor called <em>Vision AI Demo</em>, using an AI assistant and the
            development platform bolt.new, without any prior programming experience. The project was lost to a
            file-path error that rendered the codebase unrecoverable, at a financial cost of €200 borrowed from
            a younger cousin.
        </p>
        <p>
            A second development cycle in mid-2024 produced five browser-based prototypes across different tool
            categories, none of which reached a functional release. These experiences led to a conceptual
            reorientation in late 2024, during which Bolognese identified motion design, rather than
            traditional timeline-based video editing, as the appropriate product category for his core idea.
        </p>

        <figure class="bio-figure">
            <Image src={imgPivot} alt="Early FlashFX motion design interface from the late-2024 pivot"
                   widths={[480, 960]} sizes="(max-width: 860px) 100vw, 720px" loading="lazy" decoding="async" />
            <figcaption>Late 2024 — the pivot from video editing to motion design</figcaption>
        </figure>

        <p>
            Between December 2024 and early 2025, he undertook an intensive period of self-directed study in
            JavaScript, TypeScript, and React, building a series of small utility applications to consolidate
            practical skills. This phase preceded the development of what would become FlashFX.
        </p>

        <figure class="bio-figure">
            <Image src={imgSubmission} alt="The FlashFX prototype submitted to the Bolt global hackathon"
                   widths={[480, 960]} sizes="(max-width: 860px) 100vw, 720px" loading="lazy" decoding="async" />
            <figcaption>June 30, 2025 — hackathon submission day</figcaption>
        </figure>

        <p>
            In mid-2025, Bolognese entered Bolt's global hackathon, assembling a three-person team that
            included an experienced TypeScript developer known through the hackathon's Discord community. The
            team submitted a working prototype of FlashFX on June 30, 2025. Although the entry did not place,
            the project attracted significant interest from fellow participants, providing external validation
            of the concept. The team formally constituted FlashFX as a company shortly thereafter, with
            Bolognese assuming the role of chief executive officer.
        </p>
        <p>
            In January 2026, longtime online acquaintance Aziz joined FlashFX as co-founder. A marketing
            manager, Camille Luciano, was subsequently appointed to lead social media and community
            development. FlashFX V1, the first fully functional public release of the application, launched in
            early 2026.
        </p>

        <h2 id="personal-profile">Personal profile</h2>
        <p>
            Bolognese has publicly described his working method as iterative and failure-tolerant,
            characterised by repeated full rebuilds of projects following significant setbacks. He has cited
            early mentorship from his first editing client, whose real name he states he never learned, as a
            formative influence on his professional development. He has also acknowledged a pattern of
            beginning new projects on or around January 1 of each year, noting that multiple significant
            personal milestones have originated in the first days of January.
        </p>
        <p>
            He communicates primarily in Italian and English, the latter acquired informally through online
            media consumption beginning at age eleven.
        </p>

        <h2 id="ventures">Ventures</h2>
        <div class="bio-table-wrap">
            <table class="bio-table">
                <thead>
                <tr><th scope="col">Year</th><th scope="col">Project</th><th scope="col">Outcome</th></tr>
                </thead>
                <tbody>
                {ventures.map((venture) => (
                    <tr>
                        <td>{venture.year}</td>
                        <td>{venture.project}</td>
                        <td>{venture.outcome}</td>
                    </tr>
                ))}
                </tbody>
            </table>
        </div>

        <h2 id="elsewhere">Elsewhere</h2>
        {/* rel="me" on each profile, matching SAME_AS in src/data/identity.ts.
            A biography page that visibly links every profile it claims in schema
            is the strongest form the sameAs signal takes. */}
        <ul class="bio-links">
            {SAME_AS.map((url) => (
                <li>
                    <a href={url} target="_blank" rel="noopener noreferrer me">{labelFor(url)}</a>
                </li>
            ))}
            <li><a href="https://flashfx.app" target="_blank" rel="noopener noreferrer">flashfx.app</a> — the FlashFX application</li>
            <li><a href="/">gabrielebolognese.blog</a> — projects, timeline and the long-form story</li>
            <li><a href="/articles">Articles</a> — writing on building FlashFX</li>
        </ul>
    </article>

    <div class="rule"></div>

    <Faq entries={HOMEPAGE_FAQ} heading="Frequently asked" />
</main>

<footer class="footer">
    <div class="footer-inner">
        <span>© 2026 Gabriele Bolognese</span>
        <span class="dot">·</span>
        <span>Rovigo, Italy</span>
        <span class="dot">·</span>
        <a href="/articles">Articles</a>
        <span class="dot">·</span>
        <a href="https://flashfx.app" target="_blank" rel="noopener noreferrer">flashfx.app</a>
    </div>
</footer>

</Layout>

<style>
    /* The article runs the full content width so the header and the split can
       use it; the prose below is pulled back to a readable measure instead of
       constraining everything to 760px. */
    .bio {
        max-width: var(--content-max);
        margin: 0 auto;
    }

    .bio > h2,
    .bio > h3,
    .bio > p,
    .bio > .bio-figure,
    .bio > .bio-table-wrap,
    .bio > .bio-links {
        max-width: 760px;
        margin-left: auto;
        margin-right: auto;
    }

    .breadcrumb ol {
        display: flex;
        gap: 10px;
        list-style: none;
        margin: 0 0 40px;
        padding: 0;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    .breadcrumb li + li::before {
        content: '/';
        margin-right: 10px;
        color: var(--gray-line);
    }

    .breadcrumb a { color: var(--gray-dark); }
    .breadcrumb a:hover { color: var(--black); }

    /* ── Header: title and the count-up, centred ─────────────────────────── */
    .bio-header {
        text-align: center;
        margin-bottom: 72px;
    }

    .bio-h1 {
        font-family: var(--font-display);
        font-size: clamp(38px, 5.5vw, 62px);
        font-weight: 300;
        line-height: 1.12;
        letter-spacing: -0.02em;
        margin-bottom: 24px;
    }

    .bio-standfirst {
        font-size: var(--text-base);
        line-height: 1.8;
        color: var(--gray-dark);
        max-width: 62ch;
        margin: 0 auto;
    }

    .age {
        margin-top: 56px;
        padding-top: 48px;
        border-top: 1px solid var(--gray-line);
    }

    .age-label {
        display: block;
        font-family: var(--font-wide);
        font-size: 9px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--gray-mid);
        margin-bottom: 32px;
    }

    .age-display {
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }

    .age-unit {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .age-num {
        font-family: var(--font-wide);
        font-weight: 200;
        font-size: clamp(48px, 8vw, 104px);
        line-height: 1;
        letter-spacing: -0.04em;
        color: var(--black);
        min-width: 2ch;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    /* Shares the countdown's digit-roll keyframe, set in Style.css. */
    .age-num.is-tick { animation: tick-in 520ms var(--ease-expo) both; }

    .age-unit-label {
        font-family: var(--font-wide);
        font-size: 8px;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--gray-line);
        margin-top: 14px;
        transition: color var(--dur) var(--ease);
    }

    .age-display:hover .age-unit-label { color: var(--gray-mid); }

    .age-sep {
        font-family: var(--font-wide);
        font-weight: 200;
        font-size: clamp(28px, 5vw, 64px);
        line-height: 1;
        color: var(--gray-line);
        margin: 0 14px;
    }

    .age-sub {
        margin-top: 28px;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    .age-sub time { color: var(--gray-dark); }

    /* ── Split: portrait + about on the left, life grid on the right ─────── */
    .bio-split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        gap: 56px;
        align-items: start;
        margin-bottom: 64px;
        padding-bottom: 56px;
        border-bottom: 1px solid var(--gray-line);
    }

    .bio-portrait {
        width: 100%;
        height: auto;
        filter: grayscale(100%);
    }

    .bio-side-heading {
        font-family: var(--font-wide);
        font-size: 9px;
        font-weight: 400;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--gray-mid);
        margin: 32px 0 18px;
    }

    .bio-panel .bio-side-heading { margin-top: 0; }

    .bio-lede {
        font-size: var(--text-sm);
        line-height: 1.9;
        color: var(--gray-dark);
        margin: 0;
    }

    /* ── Life in weeks ───────────────────────────────────────────────────── */
    .life-intro {
        font-size: var(--text-xs);
        letter-spacing: 0.06em;
        color: var(--gray-mid);
        margin-bottom: 24px;
    }

    .life-caption {
        margin-top: 22px;
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    .life-caption strong {
        font-weight: 400;
        color: var(--black);
    }

    .life-key {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 24px;
        list-style: none;
        padding: 0;
        margin: 16px 0 0;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    .life-key li {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @media (max-width: 900px) {
        .bio-split {
            grid-template-columns: 1fr;
            gap: 48px;
        }

        .bio-portrait { max-width: 320px; }
    }

    @media (max-width: 520px) {
        .age-num { font-size: clamp(34px, 13vw, 56px); }
        .age-sep { font-size: clamp(20px, 8vw, 34px); margin: 0 8px; }
        .life-grid { gap: 1px; }
    }

    .bio h2 {
        font-family: var(--font-display);
        font-size: var(--text-2xl);
        font-weight: 400;
        line-height: 1.25;
        margin: 64px 0 20px;
    }

    .bio h3 {
        font-family: var(--font-display);
        font-size: var(--text-lg);
        font-weight: 400;
        margin: 44px 0 16px;
        color: var(--gray-dark);
    }

    .bio p {
        font-size: var(--text-sm);
        line-height: 1.95;
        color: var(--gray-dark);
        margin-bottom: 22px;
    }

    .bio a { color: var(--black); border-bottom: 1px solid var(--gray-line); }
    .bio a:hover { border-color: var(--black); }

    .bio-figure {
        margin: 44px 0;
    }

    .bio-figure img {
        width: 100%;
        height: auto;
        display: block;
        filter: grayscale(100%);
    }

    .bio-figure figcaption {
        margin-top: 12px;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    /* Wide content scrolls inside its own container so the page body never does. */
    .bio-table-wrap {
        overflow-x: auto;
        margin: 28px 0;
    }

    .bio-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
        min-width: 520px;
    }

    /* Three columns of prose cannot fit a phone, so the table keeps its own
       horizontal scroll rather than making the page body scroll. Tightened up
       so most rows are readable without scrolling at all. */
    @media (max-width: 620px) {
        .bio-table { min-width: 440px; font-size: 12px; }
        .bio-table th,
        .bio-table td { padding: 12px 12px 12px 0; }
    }

    .bio-table th,
    .bio-table td {
        text-align: left;
        padding: 14px 16px 14px 0;
        border-bottom: 1px solid var(--gray-line);
        vertical-align: top;
        line-height: 1.6;
    }

    .bio-table th {
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--gray-mid);
