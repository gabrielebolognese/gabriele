---
/* Replaces public/story.html, which was indexable, orphaned, entirely unstyled,
   and canonicalised to flashfx.app, telling Google to credit another domain for
   1,000 words of biography hosted here. Same prose, now a first-class page:
   self-canonical, styled, and linked from the nav and footer. */
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Faq from '../components/Faq.astro';
import LifeSection from '../components/LifeSection.astro';
import { aboutPageSchema } from '../data/schema';
import { HOMEPAGE_FAQ } from '../data/faq';
import { PERSON, FACTS, SAME_AS, absoluteUrl } from '../data/identity';
import { PORTRAIT, schemaImageUrl } from '../data/images';
import portrait from '../assets/gabriele-bolognese-portrait.png';
import imgVision from '../assets/vision-ai-demo-video-editor-2024.png';
import imgPivot from '../assets/flashfx-early-motion-design-interface-2024.png';
import imgSubmission from '../assets/flashfx-bolt-hackathon-prototype.png';

/* The question stays in the third person on purpose: it is the phrase people
   type into a search box. The page answers it in the first person. */
const title = 'Who is Gabriele Bolognese? Founder of FlashFX';
const description =
    'My full story: Italian founder of FlashFX, from a hacked Minecraft channel in 2020 to a browser-based motion graphics platform used by thousands.';

const schema = aboutPageSchema({
    portraitUrl: await schemaImageUrl(portrait, PORTRAIT, Astro.site),
    path: Astro.url.pathname,
    // No FAQPage node here on purpose: the homepage already owns that entity,
    // and the same FAQPage on two indexable URLs is what made story.html and
    // the homepage compete with each other in the first place. The questions
    // are still rendered below, useful to readers and to answer engines,
    // which extract visible Q&A regardless of markup.
    faq: [],
});

/** Human label for a profile URL, so the Elsewhere list reads as prose. */
function labelFor(url: string): string {
    const host = new URL(url).hostname.replace(/^www\./, '');
    const map: Record<string, string> = {
        'linkedin.com': 'LinkedIn',
        'github.com': 'GitHub',
        'youtube.com': 'YouTube',
        'instagram.com': 'Instagram',
        'producthunt.com': 'Product Hunt',
        'peerlist.io': 'Peerlist',
        'connectively.us': 'Connectively',
        'x.com': 'X',
    };
    return map[host] ?? host;
}

const ventures = [
    { year: '2020–2022', project: 'YouTube channel playmoj', outcome: 'Terminated following account compromise' },
    { year: '2022–2023', project: 'Freelance editing via Fiverr (Emerals)', outcome: '$1,200 total earnings; client concluded operations' },
    { year: '2024', project: 'Vision AI Demo', outcome: 'Lost to development error; €200 debt' },
    { year: '2024', project: 'Five browser-based tool prototypes', outcome: 'None reached functional release' },
    { year: '2025–present', project: 'FlashFX', outcome: 'Active; V1 launched early 2026' },
];
---
<Layout title={title} description={description} type="profile" schema={schema}>

<Nav />

<main id="main">
    <article class="section bio">

        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-current="page">About</li>
            </ol>
        </nav>

        <header class="bio-header">
            <h1 class="bio-h1">Who is Gabriele Bolognese?</h1>
            <p class="bio-standfirst">
                Italian founder and lead developer of
                <a href="https://flashfx.app" target="_blank" rel="noopener noreferrer">FlashFX</a>, from a hacked Minecraft channel in 2020 to a browser-based motion graphics and video
                editing platform used by over {FACTS.usersLabel} people.
            </p>

        </header>

        <LifeSection aboutHeading="About" >
            <p>
                I am <strong>Gabriele Bolognese</strong>, born 6 December 2008, an Italian software
                developer and founder. I run FlashFX, a browser-based motion design and video editing
                app that more than {FACTS.usersLabel} people use.
            </p>
            <p>
                I started teaching myself video production at eleven, editing Minecraft footage on a
                laptop that could barely handle it, and I moved into freelance editing at fourteen. I
                wrote my first line of code in January 2024 and taught myself JavaScript, TypeScript
                and React over the year that followed, with no formal training in computer science.
            </p>
            <p>
                FlashFX took four complete rebuilds before it worked. The first attempt I lost entirely
                to a file-path error, and the money I had spent on it was not even mine, I had borrowed
                it. What survived every collapse was the idea underneath: that professional motion
                design belongs in the browser, free of installs and licences, in reach of anyone with a
                laptop.
            </p>
            <p>
                I work from the Veneto region of northern Italy, I compete in the Italian mathematics
                nationals at champion level, and I train in gymnastics and sprinting.
            </p>
        </LifeSection>
        </div>

        <h2 id="early-life">Early life and education</h2>
        <p>
            I was born in December 2008 and grew up in the Veneto region. I went to secondary school
            locally and later enrolled at IIS Viola Marchesini. My school years got messy, because I was
            running professional work in parallel with studying, and in 2025 I failed the year and had to
            sit a recovery exam before I could move up.
        </p>
        <p>
            Outside of school I did karate competitively for most of my adolescence, though how
            consistently depended entirely on how much else I had on. In 2025 the long stretches of
            building meant I stopped training for months at a time.
        </p>
        <p>
            I am self-taught in everything I do professionally. I picked up English almost entirely from
            online content between eleven and thirteen, without a single lesson, which is probably why I
            still make the occasional mistake in it. I started learning JavaScript, TypeScript and React
            on my own in late December 2024.
        </p>

        <h2 id="career">Career</h2>

        <h3 id="content-creation">Content creation (2020&#8211;2022)</h3>
        <p>
            During the lockdowns of 2020, when I was eleven, I started posting Minecraft videos on
            YouTube under the name <em>playmoj</em>. I was working on hardware that really was not up to
            it, teaching myself to edit in Shotcut and then CapCut, and putting out somewhere between one
            and four videos a day. The channel got to around 1,560 subscribers across more than 600
            uploads before it was compromised in 2022 by a third-party service, which deleted everything
            I had published and turned the account into a scam. That was the end of me as a creator.
        </p>

        <h3 id="freelance-editing">Freelance video editing (2022&#8211;2025)</h3>
        <p>
            At fourteen I made a Fiverr profile, mostly because I wanted to buy a piece of hardware and
            had no way to pay for it. My first client was a GTA-themed YouTube channel called Emerals,
            who found me through someone going by the alias <em>hansa</em>. It started at five dollars a
            video and worked its way up to twenty over about six months. In total that contract earned me
            around $1,200.
        </p>
        <p>
            After it ended in mid-2023 my Fiverr listings brought in nothing for months. I came back to
            freelance editing on and off through 2024 and into 2025, when a client in the finance niche
            put me on $250 a month for a package of videos. I ended up loosing that one after five
            deliveries, and honestly it was because of me, I was late constantly and the revisions kept
            piling up while I was trying to edit, build FlashFX and keep up with school all at once.
        </p>

        <h3 id="software-development">Software development and entrepreneurship (2024&#8211;present)</h3>

        <figure class="bio-figure">
            <Image src={imgVision} alt="The Vision AI Demo browser-based video editor, 2024"
                   widths={[480, 960]} sizes="(max-width: 860px) 100vw, 720px" loading="lazy" decoding="async" />
            <figcaption>2024, Vision AI Demo, the first attempt</figcaption>
        </figure>

        <p>
            I got into software almost by accident, through the AI content automation tools I was playing
            with in late 2023. On January 3, 2024 I started my first ever project, a browser-based video
            editor called <em>Vision AI Demo</em>, using an AI assistant and bolt.new, having never
            programmed before in my life. I lost it to a file-path error that made the codebase
            unrecoverable, and it cost me &#8364;200 that I had borrowed off my younger cousin.
        </p>
        <p>
            A second run in mid-2024 produced five browser-based prototypes across different categories
            and not one of them ever shipped. Those failures are what made me rethink the whole thing, and
            by late 2024 I had worked out that motion design, and not traditional timeline video editing,
            was the right category for what I actually wanted to build.
        </p>

        <figure class="bio-figure">
            <Image src={imgPivot} alt="Early FlashFX motion design interface from the late-2024 pivot"
                   widths={[480, 960]} sizes="(max-width: 860px) 100vw, 720px" loading="lazy" decoding="async" />
            <figcaption>Late 2024, the pivot from video editing to motion design</figcaption>
        </figure>

        <p>
            Between December 2024 and early 2025 I did nothing but study. JavaScript, TypeScript, React,
            building small useless utilities one after another until the fundamentals stuck. All of that
            came before a single line of what became FlashFX.
        </p>

        <figure class="bio-figure">
            <Image src={imgSubmission} alt="The FlashFX prototype submitted to the Bolt global hackathon"
                   widths={[480, 960]} sizes="(max-width: 860px) 100vw, 720px" loading="lazy" decoding="async" />
            <figcaption>June 30, 2025, hackathon submission day</figcaption>
        </figure>

        <p>
            In mid-2025 I entered the Bolt global hackathon and put together a team of three, including an
            experienced TypeScript developer I met in the hackathon Discord. We submitted a working
            FlashFX prototype on June 30, 2025. We did not place, but the reaction from the other
            participants was definately the first real signal that the idea was worth something. Shortly after, we
            made FlashFX an actual company and I took the CEO role.
        </p>
        <p>
            In January 2026 someone I had known online for years joined me as co-founder. Me and him
            then brought in Camille Luciano as marketing manager to run social and community. FlashFX V1,
            the first properly working public release, launched in early 2026.
        </p>

        <h2 id="personal-profile">Personal profile</h2>
        <p>
            The way I work is iterative and it tolerates failure well, mostly because it has had to. I
            rebuild things from nothing when they break rather then patching around the damage. A lot of
            how I think about this came from my first editing client, who kept me on when my work was bad
            and whose real name I never even learned. I have also noticed I start almost everything around
            January 1, and a strange number of the things that mattered to me began in the first days of
            January.
        </p>
        <p>
            I speak Italian and English. The English I picked up informally from the internet starting at
            eleven, which I think shows sometimes.
        </p>

        <h2 id="ventures">Ventures</h2>
        <div class="bio-table-wrap">
            <table class="bio-table">
                <thead>
                <tr><th scope="col">Year</th><th scope="col">Project</th><th scope="col">Outcome</th></tr>
                </thead>
                <tbody>
                {ventures.map((venture) => (
                    <tr>
                        <td>{venture.year}</td>
                        <td>{venture.project}</td>
                        <td>{venture.outcome}</td>
                    </tr>
                ))}
                </tbody>
            </table>
        </div>

        <h2 id="elsewhere">Elsewhere</h2>
        {/* rel="me" on each profile, matching SAME_AS in src/data/identity.ts.
            A biography page that visibly links every profile it claims in schema
            is the strongest form the sameAs signal takes. */}
        <ul class="bio-links">
            {SAME_AS.map((url) => (
                <li>
                    <a href={url} target="_blank" rel="noopener noreferrer me">{labelFor(url)}</a>
                </li>
            ))}
            <li><a href="https://flashfx.app" target="_blank" rel="noopener noreferrer">flashfx.app</a>, the FlashFX application</li>
            <li><a href="/">gabrielebolognese.blog</a>, projects, timeline and the long-form story</li>
            <li><a href="/newsletter/">The newsletter</a>, what I am building and what it cost</li>
        </ul>
    </article>

    <div class="rule"></div>

    <Faq entries={HOMEPAGE_FAQ} heading="Frequently asked" />
</main>

<footer class="footer">
    <div class="footer-inner">
        <span>© 2026 Gabriele Bolognese</span>
        <span class="dot">·</span>
        <a href="/license/">Image licence</a>
        <span class="dot">·</span>
        <span>Rovigo, Italy</span>
        <span class="dot">·</span>
        <a href="/newsletter/">Newsletter</a>
        <span class="dot">·</span>
        <a href="https://flashfx.app" target="_blank" rel="noopener noreferrer">flashfx.app</a>
    </div>
</footer>

</Layout>

<style>
    /* The article runs the full content width so the header and the split can
       use it; the prose below is pulled back to a readable measure instead of
       constraining everything to 760px. */
    .bio {
        max-width: var(--content-max);
        margin: 0 auto;
    }

    .bio > h2.bio > h3.bio > p.bio > .bio-figure.bio > .bio-table-wrap.bio > .bio-links {
        max-width: 760px;
        margin-left: auto;
        margin-right: auto;
    }

    .breadcrumb ol {
        display: flex;
        gap: 10px;
        list-style: none;
        margin: 0 0 40px;
        padding: 0;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    .breadcrumb li + li::before {
        content: '/';
        margin-right: 10px;
        color: var(--gray-line);
    }

    .breadcrumb a { color: var(--gray-dark); }
    .breadcrumb a:hover { color: var(--black); }

    /* ── Header: title and the count-up, centred ─────────────────────────── */
    .bio-header {
        text-align: center;
        margin-bottom: 72px;
    }

    .bio-h1 {
        font-family: var(--font-display);
        font-size: clamp(38px, 5.5vw, 62px);
        font-weight: 300;
        line-height: 1.12;
        letter-spacing: -0.02em;
        margin-bottom: 24px;
    }

    .bio-standfirst {
        font-size: var(--text-base);
        line-height: 1.8;
        color: var(--gray-dark);
        max-width: 62ch;
        margin: 0 auto;
    }

    .bio h2 {
        font-family: var(--font-display);
        font-size: var(--text-2xl);
        font-weight: 400;
        line-height: 1.25;
        margin: 64px 0 20px;
    }

    .bio h3 {
        font-family: var(--font-display);
        font-size: var(--text-lg);
        font-weight: 400;
        margin: 44px 0 16px;
        color: var(--gray-dark);
    }

    .bio p {
        font-size: var(--text-sm);
        line-height: 1.95;
        color: var(--gray-dark);
        margin-bottom: 22px;
    }

    .bio a { color: var(--black); border-bottom: 1px solid var(--gray-line); }
    .bio a:hover { border-color: var(--black); }

    .bio-figure {
        margin: 44px 0;
    }

    .bio-figure img {
        width: 100%;
        height: auto;
        display: block;
        filter: grayscale(100%);
    }

    .bio-figure figcaption {
        margin-top: 12px;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    /* Wide content scrolls inside its own container so the page body never does. */
    .bio-table-wrap {
        overflow-x: auto;
        margin: 28px 0;
    }

    .bio-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
        min-width: 520px;
    }

    /* Three columns of prose cannot fit a phone, so the table keeps its own
       horizontal scroll rather than making the page body scroll. Tightened up
       so most rows are readable without scrolling at all. */
    @media (max-width: 620px) {
        .bio-table { min-width: 440px; font-size: 12px; }
        .bio-table th.bio-table td { padding: 12px 12px 12px 0; }
    }

    .bio-table th.bio-table td {
        text-align: left;
        padding: 14px 16px 14px 0;
        border-bottom: 1px solid var(--gray-line);
        vertical-align: top;
        line-height: 1.6;
    }

    .bio-table th {
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--gray-mid);
        font-weight: 400;
    }

    .bio-table td { color: var(--gray-dark); }

    .bio-links {
        list-style: none;
        padding: 0;
        margin: 24px 0 0;
        font-size: var(--text-sm);
        line-height: 2.2;
        color: var(--gray-dark);
    }

    @media (max-width: 520px) {
        .bio h2 { margin-top: 48px; }
    }
</style>

