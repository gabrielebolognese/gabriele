---
import { getCollection, render } from 'astro:content';
import IssueLayout from '../../layouts/IssueLayout.astro';

export async function getStaticPaths() {
    const issues = await getCollection('newsletter', ({ data }) => !data.draft);
    return issues.map(issue => ({
        params: { slug: issue.id },
        props: { issue },
    }));
}

const { issue } = Astro.props;
const { Content } = await render(issue);

// Feeds BlogPosting.wordCount and the reading-time estimate. `body` is the raw
// source, which is close enough for a signal that only needs to be
// approximately right — though on .mdx it also counts import lines and JSX
// attributes, so it reads slightly long on image-heavy issues.
const wordCount = issue.body?.trim().split(/\s+/).length ?? 0;
---
<IssueLayout {...issue.data} wordCount={wordCount}>
    <Content />
</IssueLayout>
