---
/* The shared document shell. Every page — including the homepage, which used
   to hand-duplicate all of this — renders through here, so canonical, OG and
   JSON-LD have exactly one implementation. */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { createHash } from 'node:crypto';
import type { ImageMetadata } from 'astro';
import SEO from '../components/SEO.astro';
import { PERSON } from '../data/identity';

/* Style.css and motion.js are served raw from public/ with stable names, so
   nothing about their URL changes when their contents do. A browser holding an
   older copy has no way to know it is stale, and this session lost three
   rounds of review to exactly that: styles were reported broken that had
   already been fixed and deployed.
   Hashing the contents into a query string gives each version its own URL, so
   a changed file is always fetched and an unchanged one still hits cache. */
function assetVersion(file: string): string {
  try {
    // Resolved from the project root, not import.meta.url — the latter points
    // into the compiled output during a build and never finds public/.
    const bytes = readFileSync(join(process.cwd(), 'public', file));
    return createHash('sha256').update(bytes).digest('hex').slice(0, 8);
  } catch {
    // Never break the build over a cache-busting nicety.
    return '';
  }
}

const styleHref = `/Style.css?v=${assetVersion('Style.css')}`;
const motionHref = `/motion.js?v=${assetVersion('motion.js')}`;

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'profile' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  schema?: unknown;
  bodyClass?: string;
}

const {
  title,
  description = PERSON.description,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex,
  schema,
  bodyClass,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEO
    title={title}
    description={description}
    image={image}
    imageAlt={imageAlt}
    type={type}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    noindex={noindex}
    schema={schema}
  />

  <link rel="stylesheet" href={styleHref} />

  <!-- Marks the document as scripted before first paint, so the reveal
       animations in Style.css only ever hide content when JS can show it. -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <script is:inline defer src={motionHref}></script>
</head>
<body class={bodyClass}>
  <a href="#main" class="skip-link">Skip to content</a>
  <slot />
</body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 300;
    padding: 12px 20px;
    background: var(--black);
    color: var(--white);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .skip-link:focus {
    left: 0;
  }
</style>
