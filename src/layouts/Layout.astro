---
/* The shared document shell. Every page — including the homepage, which used
   to hand-duplicate all of this — renders through here, so canonical, OG and
   JSON-LD have exactly one implementation. */
import type { ImageMetadata } from 'astro';
import SEO from '../components/SEO.astro';
import { PERSON } from '../data/identity';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'profile' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  schema?: unknown;
  bodyClass?: string;
}

const {
  title,
  description = PERSON.description,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex,
  schema,
  bodyClass,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <SEO
    title={title}
    description={description}
    image={image}
    imageAlt={imageAlt}
    type={type}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    noindex={noindex}
    schema={schema}
  />

  <link rel="stylesheet" href="/Style.css" />

  <!-- Marks the document as scripted before first paint, so the reveal
       animations in Style.css only ever hide content when JS can show it. -->
  <script is:inline>document.documentElement.classList.add('js');</script>
  <script is:inline defer src="/motion.js"></script>
</head>
<body class={bodyClass}>
  <a href="#main" class="skip-link">Skip to content</a>
  <slot />
</body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 300;
    padding: 12px 20px;
    background: var(--black);
    color: var(--white);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .skip-link:focus {
    left: 0;
  }
</style>
