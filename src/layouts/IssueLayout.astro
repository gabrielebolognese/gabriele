---
/* Was ArticleLayout. The reading page for one issue.
 *
 * The body is a named-column grid rather than a 680px box, which is what lets a
 * <Figure width="wide"> break past the text without negative margins. MDX
 * content lands as direct children of the slot, so figures are direct grid
 * children and the column assignment in Style.css applies to them directly,
 * wrap the slot in anything and that stops working.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { issueSchema } from '../data/schema';
import { NEWSLETTER, absoluteUrl } from '../data/identity';
import { PORTRAIT, COVER, schemaImageUrl } from '../data/images';
import portrait from '../assets/gabriele-bolognese-portrait.png';

interface Props {
  issue: number;
  title: string;
  description: string;
  standfirst?: string;
  image: ImageMetadata;
  imageAlt?: string;
  date: Date;
  updated?: Date;
  wordCount?: number;
  noindex?: boolean;
}

const { issue, title, description, standfirst, image, imageAlt, date, updated, wordCount, noindex } =
  Astro.props;

const dateLabel = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const issueLabel = String(issue).padStart(3, '0');

/* 200 wpm is the usual reading-speed figure. Floored at 1 so a short issue is
   never billed as a "0 min read". */
const readingTime = wordCount ? Math.max(1, Math.round(wordCount / 200)) : null;

const schema = issueSchema({
  title,
  description,
  path: Astro.url.pathname,
  imageUrl: await schemaImageUrl(image, COVER, Astro.site),
  published: date,
  modified: updated,
  wordCount,
  issue,
  portraitUrl: await schemaImageUrl(portrait, PORTRAIT, Astro.site),
});
---
<Layout
    title={`${title}, ${NEWSLETTER.name}`}
    description={description}
    image={image}
    imageAlt={imageAlt ?? title}
    type="article"
    publishedTime={date}
    modifiedTime={updated}
    noindex={noindex}
    schema={schema}
>

    <Nav />

    <main id="main">
        <article class="section issue">
            {/* Matches the BreadcrumbList in the JSON-LD, and gives the issue a
                way back into the archive instead of being a dead end. */}
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li><a href="/newsletter/">Newsletter</a></li>
                    <li aria-current="page">№ {issueLabel}</li>
                </ol>
            </nav>

            <header class="issue-masthead">
                <p class="issue-meta">
                    <span class="issue-num">№ {issueLabel}</span>
                    <span class="dot">·</span>
                    <time datetime={date.toISOString()}>{dateLabel}</time>
                    {readingTime && (
                        <Fragment>
                            <span class="dot">·</span>
                            <span>{readingTime} min read</span>
                        </Fragment>
                    )}
                </p>
                <h1 class="issue-h1">{title}</h1>
                <p class="issue-standfirst">{standfirst ?? description}</p>
            </header>

            <Image
                src={image}
                alt={imageAlt ?? `Cover image for “${title}”`}
                class="issue-cover"
                widths={[640, 1040, 2080]}
                sizes="(max-width: 1100px) 100vw, 1040px"
                loading="eager"
                fetchpriority="high"
                decoding="async"
            />

            {/* Direct children of the grid, do not wrap the slot. */}
            <div class="issue-body">
                <slot />
            </div>

            <div class="issue-foot">
                <SubscribeForm variant="foot" />
                <p class="issue-back"><a href="/newsletter/">&#8592; All issues</a></p>
            </div>
        </article>
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <span>© 2026 Gabriele Bolognese</span>
            <span class="dot">·</span>
            <a href="/license/">Image licence</a>
            <span class="dot">·</span>
            <a href="/about/">About</a>
            <span class="dot">·</span>
            <a href="/rss.xml">RSS</a>
            <span class="dot">·</span>
            <a href="https://flashfx.app" target="_blank" rel="noopener noreferrer">flashfx.app</a>
        </div>
    </footer>

</Layout>

<style>
    .breadcrumb {
        margin-bottom: 32px;
    }

    .breadcrumb ol {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--gray-mid);
    }

    .breadcrumb li + li::before {
        content: '/';
        margin-right: 10px;
        color: var(--gray-line);
    }

    .breadcrumb a { color: var(--gray-dark); }
    .breadcrumb a:hover { color: var(--black); }

    .breadcrumb li[aria-current] {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 40ch;
    }
</style>
