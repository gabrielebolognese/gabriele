---
/* One project. Rendered four times from PROJECTS in src/data/projects.ts, so
 * the four cannot drift the way the hand-written ones did.
 *
 * The card is NOT a link. It carries two buttons, and a card-wide stretched
 * link sitting under them would either swallow their clicks or be swallowed by
 * them depending on stacking order. Two explicit targets beat one ambiguous
 * one.
 */
import { Image, getImage } from 'astro:assets';
import { STATUS_LABEL, type Project } from '../data/projects';

interface Props {
  project: Project;
  /** 01, 02, 03, 04. Passed in rather than derived, because the card should
   *  not need to know where it sits in the list. */
  index: number;
}

const { project, index } = Astro.props;
const n = String(index + 1).padStart(2, '0');
/** Scopes the radio group and the label `for`s to this card. */
const slug = project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');

/* A bigger variant for the full-screen viewer, resolved here rather than
   letting the lightbox upscale the 960px card image: these are screenshots,
   and 10px UI text is exactly what upscaling ruins. Carried on the <img> as a
   data attribute so motion.js needs no second source of truth. */
const fullSizes = await Promise.all(
  project.images.map((src) => getImage({ src, width: 1600, format: 'webp', quality: 72 })),
);
---

<article class="project-card">
  {/* One shot renders a plain image. Several render a CSS-only slideshow:
      radio inputs, one per slide, and the labels beside them are the dots. No
      JavaScript, so it works under a strict script-src and without motion.js,
      and it is keyboard-operable for free because a radio group already is.

      `name` is scoped to the project so two galleries on one page do not fight
      over the same group. */}
  {project.images.length > 0 ? (
    <figure class={`project-shot${project.images.length > 1 ? ' has-slides' : ''}`}>
      {project.images.length > 1 && project.images.map((_, i) => (
        <input
          class="project-slide-input"
          type="radio"
          name={`shot-${slug}`}
          id={`shot-${slug}-${i}`}
          checked={i === 0}
        />
      ))}

      <div class="project-slides" role="group" aria-label={project.imageAlt}>
        {project.images.map((image, i) => (
          <Image
            src={image}
            alt={project.images.length > 1
              ? `${project.imageAlt}, view ${i + 1} of ${project.images.length}`
              : project.imageAlt}
            widths={[480, 960]}
            sizes="(max-width: 860px) 100vw, 520px"
            loading="lazy"
            decoding="async"
            quality={72}
            data-full={fullSizes[i].src}
          />
        ))}
      </div>

      {/* Arrows and the expand button are added to the markup but hidden
          until html.js is set, the same gate the skip controls use: without
          JavaScript they would be three controls that do nothing, while the
          dots below still work because they are labels for real radios. */}
      {project.images.length > 1 && (
        <div class="project-arrows" aria-hidden="true">
          <button class="project-arrow" type="button" data-dir="-1" tabindex="-1">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 5 8 12l7 7" />
            </svg>
          </button>
          <button class="project-arrow" type="button" data-dir="1" tabindex="-1">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      )}

      <button class="project-expand" type="button" data-project={project.name}>
        <span class="visually-hidden">Open {project.name} screenshots full screen</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 3H3v6" />
          <path d="M15 21h6v-6" />
          <path d="M3 3l7 7" />
          <path d="M21 21l-7-7" />
        </svg>
      </button>

      {project.images.length > 1 && (
        <div class="project-dots">
          {project.images.map((_, i) => (
            <label class="project-dot" for={`shot-${slug}-${i}`}>
              <span class="visually-hidden">Show view {i + 1} of {project.images.length}</span>
            </label>
          ))}
        </div>
      )}
    </figure>
  ) : (
    /* No screenshot yet. An empty panel rather than an unrelated product's
       screenshot, which is what these cards used to borrow. */
    <div class="project-shot is-empty">
      <span>No screenshot yet</span>
    </div>
  )}

  <div class="project-body">
    <p class="project-rail">
      <span class="project-index">{n}</span>
      <span class="project-status" data-status={project.status}>{STATUS_LABEL[project.status]}</span>
      <span class="project-since">Since {project.since}</span>
    </p>

    <h3 class="project-name">{project.name}</h3>

    {project.summary
      ? <p class="project-summary">{project.summary}</p>
      : (
        /* Deliberately visible. Three of these four have no description yet,
           and a blank card reads as a layout bug while an invented one reads
           as fact. This reads as what it is. */
        <p class="project-summary is-placeholder">One line about this project, once you write it.</p>
      )}

    {project.stack.length > 0 && (
      <ul class="project-stack">
        {project.stack.map((tool) => <li>{tool}</li>)}
      </ul>
    )}

    {/* Both buttons always render. A missing URL is disabled rather than
        hidden, so the four cards keep one shape and "no repository yet" reads
        as a fact rather than as a card someone forgot to finish. */}
    <div class="project-actions">
      <a
        class={`project-btn${project.site ? '' : ' is-disabled'}`}
        href={project.site}
        target={project.site ? '_blank' : undefined}
        rel={project.site ? 'noopener noreferrer' : undefined}
        aria-disabled={project.site ? undefined : 'true'}
        tabindex={project.site ? undefined : '-1'}
      >
        Go to site
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
          <path d="M18 13.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5.5" />
          <path d="M10.5 13.5 21 3" />
          <path d="M15 3h6v6" />
        </svg>
      </a>

      <a
        class={`project-btn${project.repo ? '' : ' is-disabled'}`}
        href={project.repo}
        target={project.repo ? '_blank' : undefined}
        rel={project.repo ? 'noopener noreferrer' : undefined}
        aria-disabled={project.repo ? undefined : 'true'}
        tabindex={project.repo ? undefined : '-1'}
      >
        Go to repository
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">
          <path d="M18 13.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5.5" />
          <path d="M10.5 13.5 21 3" />
          <path d="M15 3h6v6" />
        </svg>
      </a>
    </div>

  </div>
</article>
