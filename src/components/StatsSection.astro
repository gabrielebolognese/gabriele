---
/* The statistics section: the only part of this site that is measured rather
 * than written. Everything else on the homepage is a claim; this is the
 * evidence, so it is deliberately placed directly under the About copy where
 * the claims are made.
 *
 * Five things, in the order a reader would want them: the totals, the year of
 * activity behind the totals, the repositories the work went into, and the
 * most recent entry of the log that describes it.
 *
 * This is the one section allowed colour. The grid keeps GitHub's own green
 * ramp because it is a quotation: anyone who has seen a contribution graph
 * reads it without a legend, and recolouring it would throw that away to gain
 * nothing. The three icons follow the same rule, they carry meaning the number
 * beside them does not.
 */
import { getCollection } from 'astro:content';
import { getGithubStats } from '../data/github';
import { getLeetcodeStats } from '../data/leetcode';
import { getYoutubeStats } from '../data/youtube';
import SocialIcon from './SocialIcon.astro';

const stats = await getGithubStats();
const lc = await getLeetcodeStats();
const yt = await getYoutubeStats();

const devlog = await getCollection('devlog');
const latest = [...devlog].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const nf = new Intl.NumberFormat('en-GB');

const longDate = (value: string | Date) =>
  new Date(value).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

/** "6 Jan - 9 Aug 2026", the span under a streak. Both ends carry a year only
 *  when the streak actually crosses one, which most do not. */
const span = (from: string | null, to: string | null) => {
  if (!from || !to) return null;
  const opts: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', timeZone: 'UTC' };
  const a = new Date(from);
  const b = new Date(to);
  const sameYear = a.getUTCFullYear() === b.getUTCFullYear();
  const left = a.toLocaleDateString('en-GB', sameYear ? opts : { ...opts, year: 'numeric' });
  const right = b.toLocaleDateString('en-GB', { ...opts, year: 'numeric' });
  return `${left} to ${right}`;
};

const anchor = (date: Date) => date.toISOString().slice(0, 10);

/* ── The difficulty donut ───────────────────────────────────────────────────
   Three arcs on one ring, drawn with stroke-dasharray rather than paths: an
   arc is a dash and a gap on a circle, which needs no arc-flag arithmetic and
   no path rewriting when a count changes.

   The palette is NOT LeetCode's own #00b8a3 / #ffc01e / #ef4743. Those pass
   colour-blind separation comfortably but the amber sits at 1.6:1 against a
   white page, which is illegible, and darkening it collapses the amber-to-red
   pair to a deutan separation of 3.5, well under the floor of 8. These three
   were stepped until all six checks pass on a light surface: lightness band,
   chroma floor, CVD separation (worst adjacent pair 11.2 protan), normal
   vision (20.5), and 3:1 contrast. Same hue families, so it still reads as
   easy / medium / hard.

   Identity never rests on colour alone regardless: every arc is directly
   labelled and the same numbers are a real list underneath. */
const DIFFICULTY_COLOURS: Record<string, string> = {
  Easy: '#00947f',
  Medium: '#c97a00',
  Hard: '#c2255c',
};

const RADIUS = 54;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
/* A 2px gap of surface between fills, per the mark spec, so two arcs that
   happen to be adjacent never read as one. */
const ARC_GAP = 2;

let cursor = 0;
const arcs = lc.breakdown
  .filter((row) => row.solved > 0)
  .map((row) => {
    const share = lc.totalSolved > 0 ? row.solved / lc.totalSolved : 0;
    const length = share * CIRCUMFERENCE;
    /* Mid-angle, measured from 12 o'clock, for the direct label. */
    const midAngle = ((cursor + length / 2) / CIRCUMFERENCE) * 360 - 90;
    const arc = {
      ...row,
      share,
      colour: DIFFICULTY_COLOURS[row.difficulty] ?? 'var(--gray-mid)',
      dash: `${Math.max(0, length - ARC_GAP)} ${CIRCUMFERENCE - Math.max(0, length - ARC_GAP)}`,
      offset: -cursor,
      labelX: 50 + Math.cos((midAngle * Math.PI) / 180) * 74,
      labelY: 50 + Math.sin((midAngle * Math.PI) / 180) * 74,
      percent: Math.round(share * 100),
    };
    cursor += length;
    return arc;
  });

const lcFigures = [
  {
    value: nf.format(lc.totalSolved),
    label: 'Problems solved',
    note: `of ${nf.format(lc.totalAvailable)} on the site`,
  },
  {
    value: nf.format(lc.activeDays),
    unit: lc.activeDays === 1 ? 'day' : 'days',
    label: 'Days active',
    note: lc.firstActive ? `Since ${longDate(lc.firstActive)}` : null,
  },
  {
    value: nf.format(lc.streak),
    unit: lc.streak === 1 ? 'day' : 'days',
    label: 'Current streak',
    note: lc.lastActive ? `Last solved ${longDate(lc.lastActive)}` : 'Not running',
  },
  /* The rank tile is wired to the real field and fills itself in the moment
     LeetCode places the account. Until then it says so: their API returns
     5,000,001 for everyone it has not ranked, and formatting that as
     "#5,000,001" would be a fabricated number rather than a missing one. */
  {
    value: lc.ranking === null ? 'Unranked' : `#${nf.format(lc.ranking)}`,
    label: 'Global rank',
    note: lc.ranking === null
      ? 'LeetCode ranks an account once it has solved enough'
      : 'Across every LeetCode account',
    muted: lc.ranking === null,
  },
];

const ytFigures = [
  {
    /* The scraped path gives YouTube's own rounded string ("1.2K
       subscribers"); the API path gives an integer. Preferring the string when
       it exists means the page shows exactly what the channel page shows,
       rather than a number that disagrees with it by rounding. */
    value: yt.subscriberText
      ? yt.subscriberText.replace(/\s*subscribers?$/i, '')
      : yt.subscribers === null ? 'Hidden' : nf.format(yt.subscribers),
    label: 'Subscribers',
    note: yt.joined ? `Channel opened ${yt.joined}` : null,
    muted: yt.subscribers === null,
  },
  {
    value: yt.videoCount === null ? '?' : nf.format(yt.videoCount),
    unit: yt.videoCount === 1 ? 'video' : 'videos',
    label: 'Published',
    note: yt.topVideos[0] ? `Latest ${longDate(yt.topVideos[0].published)}` : null,
  },
  {
    value: yt.viewCount === null ? '?' : nf.format(yt.viewCount),
    label: 'Total views',
    note: 'Across the whole channel',
  },
];

/** Days since the first solve. The copy calls the account new; this is what
 *  makes that a measurement rather than a sentence that quietly goes stale. */
const accountAgeDays = lc.firstActive
  ? Math.max(
      0,
      Math.round((Date.parse(`${lc.capturedAt.slice(0, 10)}T00:00:00Z`)
        - Date.parse(`${lc.firstActive}T00:00:00Z`)) / 86_400_000),
    )
  : null;

/* One icon per figure, and only three of them on the whole page, so they are
 * written out here rather than pulled through a generic icon component. The
 * flames are the only animated decoration on the site: `long` is the record
 * and burns, `current` is simply lit. */
type Icon = 'code' | 'flame-long' | 'flame-current';

const figures: {
  value: string;
  unit?: string;
  label: string;
  note: string | null;
  icon: Icon;
  breakdown?: boolean;
}[] = [
  {
    value: nf.format(stats.totalContributions),
    label: 'Total contributions',
    note: stats.firstContribution ? `Since ${longDate(stats.firstContribution)}` : null,
    icon: 'code',
    breakdown: true,
  },
  {
    value: nf.format(stats.longestStreak.days),
    unit: stats.longestStreak.days === 1 ? 'day' : 'days',
    label: 'Longest streak',
    note: span(stats.longestStreak.from, stats.longestStreak.to),
    icon: 'flame-long',
  },
  {
    value: nf.format(stats.currentStreak.days),
    unit: stats.currentStreak.days === 1 ? 'day' : 'days',
    label: 'Current streak',
    note: span(stats.currentStreak.from, stats.currentStreak.to) ?? 'Not running',
    icon: 'flame-current',
  },
];

/* The external-link mark, drawn once and used by both block titles: a box with
   an arrow leaving its top-right corner. Split into three paths rather than one
   so the corner the arrow escapes from is genuinely open, which is what makes
   it read as "leaves this page" rather than as a box with a tick in it. */
const OUT_BOX = 'M18 13.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5.5';
const OUT_ARROW = 'M10.5 13.5 21 3';
const OUT_CORNER = 'M15 3h6v6';

/** The same silhouette at both sizes, so the two flames read as one family. */
const FLAME_BODY =
  'M12 1.6c.6 3.3-1.4 4.7-2.9 6.2C7.4 9.5 6.6 11.2 6.6 13.2c0 4 3 6.6 5.4 9.2 '
  + '2.4-2.6 5.4-5.2 5.4-9.2 0-2.9-1.6-4.8-3.2-6.6C12.8 5 12.3 3.3 12 1.6Z';
const FLAME_CORE =
  'M12 10c.4 1.9-.9 2.6-1.7 3.5-.5.6-.8 1.3-.8 2.1 0 1.9 1.5 3.2 2.5 4.6 '
  + '1-1.4 2.5-2.7 2.5-4.6 0-1.4-.8-2.3-1.6-3.2-.6-.7-.9-1.5-.9-2.4Z';
---

<section class="section stats-section" id="stats" aria-labelledby="stats-heading">
    <h2 class="section-label" id="stats-heading">Statistics</h2>
    {/* Names every source below it. If a block is ever added whose numbers are
        NOT fetched, this sentence stops being true for the whole section, so
        the block goes somewhere else or this line changes with it. */}
    <p class="section-intro">
        Read from GitHub, LeetCode and YouTube at build time, not typed in by hand.
    </p>

    {/* Two blocks, kept firmly apart: one account has two years of history and
        the other is days old, and running their numbers together would let the
        full one flatter the empty one. */}
    <div class="stat-block" id="github-statistics" aria-labelledby="github-statistics-heading">
        <header class="stat-block-head">
            <span class="stat-block-mark" aria-hidden="true">
                <SocialIcon name="github" size={30} />
            </span>
            <div>
                {/* The heading IS the link out. It was a plain heading with the
                    profile linked from the prose underneath, which put the one
                    thing a reader wants from this block (the account itself)
                    in the least prominent place on it. */}
                <h3 class="stat-block-title" id="github-statistics-heading">
                    <a class="stat-block-link" href={stats.profileUrl}
                       target="_blank" rel="noopener noreferrer me">
                        GitHub statistics
                        <svg class="stat-block-out" width="15" height="15" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <path d={OUT_BOX} />
                            <path d={OUT_ARROW} />
                            <path d={OUT_CORNER} />
                        </svg>
                    </a>
                </h3>
                <p class="stat-note">
                    Every number below is read from @{stats.login} at build time.
                </p>
            </div>
        </header>

    <div class="stat-figures">
        {figures.map((f) => (
            <div class="stat-figure">
                <span class={`stat-icon stat-icon--${f.icon}`} aria-hidden="true">
                    {f.icon === 'code' && (
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M8.5 7.5 3 12l5.5 4.5" />
                            <path d="M15.5 7.5 21 12l-5.5 4.5" />
                            <path d="M13.6 4.5 10.4 19.5" />
                        </svg>
                    )}
                    {f.icon === 'flame-long' && (
                        <svg viewBox="0 0 24 24" width="40" height="40">
                            <defs>
                                <linearGradient id="flame-long-grad" x1="0.2" y1="1" x2="0.7" y2="0">
                                    <stop offset="0%" stop-color="#e0362f" />
                                    <stop offset="45%" stop-color="#c2185b" />
                                    <stop offset="100%" stop-color="#7b3ff2" />
                                </linearGradient>
                            </defs>
                            <path class="flame-body" fill="url(#flame-long-grad)" d={FLAME_BODY} />
                            <path class="flame-core" fill="#ffb300" d={FLAME_CORE} />
                        </svg>
                    )}
                    {f.icon === 'flame-current' && (
                        <svg viewBox="0 0 24 24" width="26" height="26">
                            <path fill="var(--red)" d={FLAME_BODY} />
                            <path fill="#e8763a" d={FLAME_CORE} />
                        </svg>
                    )}
                </span>

                <p class="stat-value">
                    {f.value}{f.unit && <span class="stat-unit">{f.unit}</span>}
                </p>
                <p class="stat-label">{f.label}</p>
                {f.note && <p class="stat-note">{f.note}</p>}

                {/* Per year, under the total. A single all-time number says how
                    much; the split says when, which is the part that changed. */}
                {f.breakdown && stats.years.length > 0 && (
                    <ul class="stat-breakdown">
                        {stats.years.map((y) => (
                            <li>
                                <span class="stat-breakdown-year">{y.year}</span>
                                <span class="stat-breakdown-value">{nf.format(y.total)}</span>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        ))}
    </div>

    <figure class="contrib">
        <figcaption class="contrib-heading">
            <h3 class="stat-subheading">Contribution history</h3>
            <p class="stat-note">
                The last two calendar years. {nf.format(stats.activeDays)} days with at least one
                contribution since the account opened.
            </p>
        </figcaption>

        {/* One grid per calendar year, stacked. Not one 106-week strip: the
            grid carries a 740px min-width for 53 columns, so two years in a
            row would be ~1,480px and would scroll sideways on every screen,
            hiding the recent end, which is the end anyone looks at.

            Inside each, one <div> per week of seven cells, so a year is 53 or
            54 columns and the layout needs no per-cell positioning. Days
            outside the year, and days that have not happened, are holes rather
            than empty squares. */}
        {stats.calendars.map((calendar) => (
            <div class="contrib-year">
                <p class="contrib-year-head">
                    <span class="contrib-year-label">{calendar.year}</span>
                    <span class="stat-note">
                        {nf.format(calendar.total)} contributions across
                        {' '}{nf.format(calendar.activeDays)} days
                    </span>
                </p>

                <div class="contrib-plot">
                    <div class="contrib-months" aria-hidden="true">
                        {calendar.months.map((m) => (
                            <span class="contrib-month" style={`--col:${m.column + 1}`}>{m.label}</span>
                        ))}
                    </div>

                    <div class="contrib-grid" role="img"
                         aria-label={`Contribution activity in ${calendar.year}: ${nf.format(calendar.total)} contributions across ${nf.format(calendar.activeDays)} days.`}>
                        {calendar.weeks.map((week) => (
                            <div class="contrib-week">
                                {week.map((day) => (
                                    day === null
                                        ? <span class="contrib-day is-empty"></span>
                                        : <span class="contrib-day" data-level={day.level}
                                                title={`${day.count === 0 ? 'No' : nf.format(day.count)} contribution${day.count === 1 ? '' : 's'} on ${longDate(day.date)}`}></span>
                                ))}
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        ))}

        <div class="contrib-foot">
            <p class="stat-note">
                {/* The handle is text, not a link: the block title above is
                    already a link to the same profile, and two of them a few
                    hundred pixels apart is one destination sold twice. */}
                {stats.live ? 'Live at build' : 'Snapshot'}, {longDate(stats.capturedAt)}.
                @{stats.login}
            </p>
            <p class="contrib-legend" aria-hidden="true">
                <span>Less</span>
                <span class="contrib-day" data-level="0"></span>
                <span class="contrib-day" data-level="1"></span>
                <span class="contrib-day" data-level="2"></span>
                <span class="contrib-day" data-level="3"></span>
                <span class="contrib-day" data-level="4"></span>
                <span>More</span>
            </p>
        </div>
    </figure>

    <div class="stats-split">
        <div class="stats-repos">
            <h3 class="stat-subheading">Main repositories</h3>
            {stats.pinned.length === 0 ? (
                <p class="stat-note">No pinned repositories could be read from the profile.</p>
            ) : (
                <ul class="repo-list">
                    {stats.pinned.map((repo) => (
                        <li class="repo-item">
                            <a class="repo-name" href={repo.url} target="_blank" rel="noopener noreferrer">
                                {repo.name}
                            </a>
                            {repo.description && <p class="repo-desc">{repo.description}</p>}
                            <p class="repo-meta">
                                {repo.language && (
                                    <span class="repo-lang">
                                        <span class="repo-dot" style={`background:${repo.languageColor ?? '#999'}`}></span>
                                        {repo.language}
                                    </span>
                                )}
                                {repo.stars > 0 && (
                                    <span class="repo-stars">
                                        {nf.format(repo.stars)} star{repo.stars === 1 ? '' : 's'}
                                    </span>
                                )}
                            </p>
                        </li>
                    ))}
                </ul>
            )}
        </div>

        {latest && (
            <div class="stats-latest">
                <h3 class="stat-subheading">Latest devlog entry</h3>
                <p class="latest-date">
                    <time datetime={anchor(latest.data.date)}>{longDate(latest.data.date)}</time>
                </p>
                <p class="latest-text">{latest.data.text}</p>
                <a class="latest-link" href={`/devlog/#${anchor(latest.data.date)}`}>
                    Read the full entry
                </a>
            </div>
        )}
    </div>
    </div>

    <div class="stat-block" id="leetcode" aria-labelledby="leetcode-heading">
        <header class="stat-block-head">
            <span class="stat-block-mark stat-block-mark--leetcode" aria-hidden="true">
                {/* LeetCode's mark, redrawn: the two strokes of a bracket with a
                    bar through them. */}
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none"
                     stroke="currentColor" stroke-width="2.1" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M14.7 2.6 7.4 10a4.6 4.6 0 0 0 0 6.5l3.3 3.3a4.6 4.6 0 0 0 6.5 0l1.6-1.6" />
                    <path d="M9.4 13.2h10.2" />
                </svg>
            </span>
            <div>
                <h3 class="stat-block-title" id="leetcode-heading">
                    <a class="stat-block-link" href={lc.profileUrl}
                       target="_blank" rel="noopener noreferrer me">
                        LeetCode
                        <svg class="stat-block-out" width="15" height="15" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <path d={OUT_BOX} />
                            <path d={OUT_ARROW} />
                            <path d={OUT_CORNER} />
                        </svg>
                    </a>
                    {/* Outside the link on purpose: it qualifies the account, it
                        is not part of what the link is called. */}
                    <span class="stat-block-caveat">new account</span>
                </h3>
                <p class="stat-note">
                    {/* The title now carries "new account", so the note opens on
                        the measurement instead of repeating the words. */}
                    {accountAgeDays !== null
                        ? `${accountAgeDays} ${accountAgeDays === 1 ? 'day' : 'days'} old, and it shows.`
                        : 'Opened recently, and it shows.'}
                    {' '}Read from @{lc.login}
                    {' '}at build time. There is nothing here to be impressed by yet, which is the
                    reason to publish it: the interesting version of this block is the one in six
                    months, and it is only interesting if this one exists.
                </p>
            </div>
        </header>

        {/* The calendar first, at the full width of the block. It used to sit
            in a column beside the donut, which squeezed 53 weeks into about
            half the measure. The grid has a min-width, so it scrolled instead
            of shrinking, and the right-hand edge, the recent submissions
            anyone actually looks for, was the part off screen. */}
        <figure class="contrib lc-calendar">
            <figcaption class="contrib-heading">
                <h4 class="stat-subheading">Submission history</h4>
                <p class="stat-note">
                    The last 12 months, drawn on the same scale as the GitHub grid above so the
                    two can be compared honestly. {nf.format(lc.activeDays)} active
                    {lc.activeDays === 1 ? ' day' : ' days'} in it.
                </p>
            </figcaption>

            <div class="contrib-plot">
                <div class="contrib-grid" role="img"
                     aria-label={`LeetCode submission activity for the last 12 months, ${lc.activeDays} active days.`}>
                    {/* Only days with something in them carry a title. On this
                        account that is 2 cells against 369 empty ones, and "No
                        submissions on 4 March" written 369 times is around
                        17 KB of HTML saying nothing. The GitHub grid above
                        titles every day because there almost every day has
                        something to say. */}
                    {lc.weeks.map((week) => (
                        <div class="contrib-week">
                            {week.map((day) => (
                                day === null
                                    ? <span class="contrib-day is-empty"></span>
                                    : <span class="contrib-day" data-level={day.level}
                                            title={day.count > 0
                                                ? `${nf.format(day.count)} submission${day.count === 1 ? '' : 's'} on ${longDate(day.date)}`
                                                : undefined}></span>
                            ))}
                        </div>
                    ))}
                </div>
            </div>

            <div class="contrib-foot">
                <p class="stat-note">
                    {lc.live ? 'Live at build' : 'Snapshot'}, {longDate(lc.capturedAt)}.
                    {lc.ranking === null && ' Not ranked yet.'}
                </p>
            </div>
        </figure>

        <div class="lc-summary">
            <figure class="lc-donut-figure">
                <figcaption class="contrib-heading">
                    <h4 class="stat-subheading">Solved by difficulty</h4>
                </figcaption>

                {arcs.length === 0 ? (
                    <p class="stat-note">Nothing solved yet.</p>
                ) : (
                    <div class="lc-donut">
                        {/* The viewBox is wider than the ring on purpose: the
                            direct labels sit outside it, and a tight box would
                            clip them at every width. */}
                        <svg viewBox="-42 -20 184 140" role="img"
                             aria-label={`${lc.totalSolved} problems solved: ${arcs.map((a) => `${a.solved} ${a.difficulty.toLowerCase()}`).join(', ')}.`}>
                            <g transform="rotate(-90 50 50)">
                                {arcs.map((arc) => (
                                    <circle class="lc-arc" cx="50" cy="50" r={RADIUS}
                                            stroke={arc.colour}
                                            stroke-dasharray={arc.dash}
                                            stroke-dashoffset={arc.offset} />
                                ))}
                            </g>

                            <text class="lc-donut-total" x="50" y="52">{nf.format(lc.totalSolved)}</text>
                            <text class="lc-donut-sub" x="50" y="68">solved</text>

                            {/* A direct label on every arc, not just the biggest.
                                Three slices is few enough that a legend box would
                                be a second thing to read for no gain, and the
                                labels are the relief the contrast check needs. */}
                            {arcs.map((arc) => (
                                <text class="lc-arc-label" x={arc.labelX} y={arc.labelY} fill={arc.colour}>
                                    {arc.difficulty} {arc.solved}
                                </text>
                            ))}
                        </svg>
                    </div>
                )}

                {/* The same numbers as text. A donut of six problems is a shape;
                    this is the part that can be read and compared. */}
                <table class="lc-table">
                    <thead>
                        <tr>
                            <th scope="col">Difficulty</th>
                            <th scope="col">Solved</th>
                            <th scope="col">Available</th>
                        </tr>
                    </thead>
                    <tbody>
                        {lc.breakdown.map((row) => (
                            <tr>
                                <th scope="row">
                                    <span class="lc-swatch" style={`--swatch:${DIFFICULTY_COLOURS[row.difficulty]}`} aria-hidden="true"></span>
                                    {row.difficulty}
                                </th>
                                <td>{nf.format(row.solved)}</td>
                                <td>{nf.format(row.available)}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </figure>

            {/* Four tiles in two rows beside the donut rather than a row of
                four across the block: at full width each would be ~250px of
                empty card around one short number. */}
            <div class="stat-figures lc-figures">
                {lcFigures.map((f) => (
                    <div class="stat-figure">
                        <p class={`stat-value${f.muted ? ' is-muted' : ''}`}>
                            {f.value}{f.unit && <span class="stat-unit">{f.unit}</span>}
                        </p>
                        <p class="stat-label">{f.label}</p>
                        {f.note && <p class="stat-note">{f.note}</p>}
                    </div>
                ))}
            </div>
        </div>
    </div>

    <div class="stat-block" id="youtube" aria-labelledby="youtube-heading">
        <header class="stat-block-head">
            <span class="stat-block-mark stat-block-mark--youtube" aria-hidden="true">
                <SocialIcon name="youtube" size={30} />
            </span>
            <div>
                <h3 class="stat-block-title" id="youtube-heading">
                    <a class="stat-block-link" href={yt.profileUrl}
                       target="_blank" rel="noopener noreferrer me">
                        YouTube
                        <svg class="stat-block-out" width="15" height="15" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true" focusable="false">
                            <path d={OUT_BOX} />
                            <path d={OUT_ARROW} />
                            <path d={OUT_CORNER} />
                        </svg>
                    </a>
                    {yt.videoCount !== null && yt.videoCount < 5 && (
                        <span class="stat-block-caveat">barely started</span>
                    )}
                </h3>
                <p class="stat-note">
                    Long form on building FlashFX, when something is worth more than a paragraph.
                    Read from @{yt.handle} at build time.
                </p>
            </div>
        </header>

        <div class="lc-summary yt-summary">
            <div class="stat-figures yt-figures">
                {ytFigures.map((f) => (
                    <div class="stat-figure">
                        <p class={`stat-value${f.muted ? ' is-muted' : ''}`}>
                            {f.value}{f.unit && <span class="stat-unit">{f.unit}</span>}
                        </p>
                        <p class="stat-label">{f.label}</p>
                        {f.note && <p class="stat-note">{f.note}</p>}
                    </div>
                ))}
            </div>

            <div class="yt-videos">
                <h4 class="stat-subheading">
                    {yt.topVideos.length > 1 ? 'Most watched' : 'The channel so far'}
                </h4>

                {yt.topVideos.length === 0 ? (
                    <p class="stat-note">No videos published yet.</p>
                ) : (
                    <ol class="yt-list">
                        {yt.topVideos.map((video) => (
                            <li class="yt-item">
                                <a class="yt-title" href={video.url} target="_blank" rel="noopener noreferrer">
                                    {video.title}
                                </a>
                                <p class="yt-meta">
                                    <span>{nf.format(video.views)} view{video.views === 1 ? '' : 's'}</span>
                                    <span>{longDate(video.published)}</span>
                                </p>
                            </li>
                        ))}
                    </ol>
                )}

                <p class="stat-note">
                    {/* Says what it ranked over. The channel feed carries the 15
                        most recent uploads at most, so "most watched" is most
                        watched of those, and on a channel this size that is
                        every video there is. */}
                    {yt.rankedFrom === 1
                        ? 'One video on the channel, so there is nothing to rank yet.'
                        : `Ranked by views across the ${nf.format(yt.rankedFrom)} most recent uploads.`}
                    {' '}{yt.live ? 'Live at build' : 'Snapshot'}, {longDate(yt.capturedAt)}.
                    {yt.source === 'public' && ' Counts read from the channel page, not the Data API.'}
                </p>
            </div>
        </div>
    </div>
</section>
