---
/* ============================================================================
   SEO.astro: owns every <head> tag that matters to a crawler.

   Replaces two hand-maintained, drifted copies of the head (one in index.astro,
   one in Layout.astro) that disagreed on canonical, Twitter handle, sameAs and
   description. Every URL here is derived from Astro.url, so a page can no
   longer claim to be a different page, which is what the old hardcoded
   canonical did to every article.
   ========================================================================= */
import type { ImageMetadata } from 'astro';
import { SITE, PERSON, ORGANIZATION, absoluteUrl } from '../data/identity';
import defaultOg from '../assets/gabriele-bolognese-og-card.png';

interface Props {
  title: string;
  description: string;
  /** An imported asset (preferred, carries real dimensions) or a root-relative
   *  path. Absolutised below, because og:image is ignored when relative, which
   *  is exactly why every article's preview image used to be dropped. */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'profile' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  /** JSON-LD @graph object for this page. */
  schema?: unknown;
}

const {
  title,
  description,
  image = defaultOg,
  imageAlt = `${PERSON.name}, founder of ${ORGANIZATION.name}`,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  schema,
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const resolved = typeof image === 'string' ? { src: image, width: 1200, height: 630 } : image;
const ogImage = absoluteUrl(resolved.src, Astro.site);
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={PERSON.name} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content={String(resolved.width)} />
<meta property="og:image:height" content={String(resolved.height)} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />

{type === 'profile' && (
  <>
    <meta property="profile:first_name" content={PERSON.givenName} />
    <meta property="profile:last_name" content={PERSON.familyName} />
    <meta property="profile:username" content={PERSON.handles.x} />
  </>
)}

{type === 'article' && publishedTime && (
  <>
    <meta property="article:published_time" content={publishedTime.toISOString()} />
    <meta property="article:modified_time" content={(modifiedTime ?? publishedTime).toISOString()} />
    <meta property="article:author" content={PERSON.name} />
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={`@${ORGANIZATION.xHandle}`} />
<meta name="twitter:creator" content={`@${PERSON.handles.x}`} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="color-scheme" content="light" />

<link rel="alternate" type="application/rss+xml" title={`${SITE.name}, Articles`} href={absoluteUrl('/rss.xml', Astro.site)} />

{/* Fonts are self-hosted, so there is no third-party stylesheet to preconnect
    to any more; the @font-face declarations are section 01 of Style.css.

    These two are preloaded because they are the only faces the first screen
    needs: Lexend for the hero headline and DM Sans for everything under it.
    Preloading is what stops font discovery waiting on Style.css to download
    and parse. The latin-ext subsets and the other two families are NOT
    preloaded on purpose, since preloading a file the page may never use costs
    exactly as much as one it does.

    crossorigin is mandatory even though these are same-origin: fonts are
    fetched in CORS mode, and a preload without it is a second, separate
    request rather than a warm cache entry. */}
<link rel="preload" href="/fonts/lexend-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

{schema && (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
)}
