---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
    title: string;
    description: string;
    image: ImageMetadata;
    imageAlt?: string;
    slug: string;
    date: Date;
}

const { title, description, image, imageAlt, slug, date } = Astro.props;

const dateLabel = date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
});
---
<a href={`/newsletter/${slug}`} class="article-card">
    <div class="article-card-img">
        {/* Distinct from the <h3> below — repeating the title verbatim as alt
            just makes a screen reader say it twice. */}
        <Image
            src={image}
            alt={imageAlt ?? `Cover image for “${title}”`}
            widths={[360, 720]}
            sizes="(max-width: 860px) 100vw, 420px"
            loading="lazy"
            decoding="async"
        />
    </div>
    <div class="article-card-body">
        <time class="article-card-date" datetime={date.toISOString()}>{dateLabel}</time>
        <h3 class="article-card-title">{title}</h3>
        <p class="article-card-desc">{description}</p>
        <span class="article-card-read">Read <i class="article-card-arrow">&#8594;</i></span>
    </div>
</a>

<style>
    /* Owns every card style; the grid that lays these out is .articles-grid
       in public/Style.css. */
    .article-card {
        display: block;
        background: var(--white);
        color: var(--black);
        overflow: hidden;
        transition: background var(--dur-slow) var(--ease);
    }

    .article-card:hover { background: var(--gray-soft); }

    .article-card-img {
        overflow: hidden;
        background: var(--gray-soft);
    }

    .article-card-img img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        filter: grayscale(100%);
        transform: scale(1.005);
        transition:
            filter    1.1s var(--ease),
            transform 1.4s var(--ease);
    }

    .article-card:hover .article-card-img img {
        filter: grayscale(0%);
        transform: scale(1.05);
    }

    .article-card-body {
        padding: 24px 28px 32px;
        border-top: 1px solid var(--gray-line);
    }

    .article-card-date {
        display: block;
        font-size: var(--text-xs);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--gray-mid);
        margin-bottom: 12px;
    }

    .article-card-title {
        font-family: var(--font-display);
        font-size: var(--text-xl);
        font-weight: 400;
        line-height: 1.3;
        color: var(--black);
        margin-bottom: 10px;
    }

    .article-card-desc {
        font-size: var(--text-sm);
        color: var(--gray-dark);
        line-height: 1.8;
        margin-bottom: 20px;
    }

    .article-card-read {
        display: inline-block;
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--gray-dark);
        border-bottom: 1px solid var(--gray-line);
        padding-bottom: 2px;
        transition:
            color        var(--dur) var(--ease),
            border-color var(--dur) var(--ease);
    }

    .article-card:hover .article-card-read {
        color: var(--black);
        border-color: var(--black);
    }

    .article-card-arrow {
        display: inline-block;
        font-style: normal;
        transition: transform var(--dur-slow) var(--ease);
    }

    .article-card:hover .article-card-arrow { transform: translateX(5px); }

    @media (prefers-reduced-motion: reduce) {
        .article-card:hover .article-card-img img { transform: none; }
        .article-card:hover .article-card-arrow { transform: none; }
    }
</style>
