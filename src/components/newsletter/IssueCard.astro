---
/* One issue as a square card, two to a row on the archive.
 *
 * No cover image, deliberately. The card is a block of the issue's actual
 * opening prose and nothing else — the cover already appears on the issue page
 * itself, and inside a square card at this size it took a third of the space
 * and left the text nowhere to go.
 *
 * The text is masked to a fade at the bottom rather than truncated, so the
 * cut always lands mid-sentence and reads as "there is more" instead of
 * "this is short".
 */
import type { ImageMetadata } from 'astro';

interface Props {
  issue: number;
  title: string;
  body: string;
  slug: string;
  date: Date;
}

const { issue, title, body, slug, date } = Astro.props;

/* The card shows the real opening of the issue, not the description. `body` is
   raw MDX, so the component syntax has to come out before it can be shown as
   prose. */
function plainText(source: string): string {
  return source
    .replace(/^import\s+.*$/gm, '')          // import lines
    .replace(/<[A-Z][\s\S]*?\/>/g, '')       // self-closing components
    .replace(/^#{1,6}\s+/gm, '')             // heading markers
    .replace(/\*\*([^*]+)\*\*/g, '$1')       // bold
    .replace(/\*([^*]+)\*/g, '$1')           // italic
    .replace(/`([^`]+)`/g, '$1')             // inline code
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // links
    .replace(/^>\s?/gm, '')                  // blockquotes
    .replace(/^[-*]\s+/gm, '')               // list markers
    .replace(/\n{2,}/g, '\n\n')
    .trim();
}

/* Enough to overflow the card at every width, so the fade always has something
   to fade. Cheaper than measuring, and the mask hides the cut. Higher than it
   was with a cover in the way, because the text now has the whole card. */
const PARAGRAPH_BUDGET = 1800;

const paragraphs: string[] = [];
let used = 0;
for (const para of plainText(body).split(/\n{2,}/)) {
  const text = para.replace(/\s+/g, ' ').trim();
  if (!text) continue;
  paragraphs.push(text);
  used += text.length;
  if (used > PARAGRAPH_BUDGET) break;
}

const dateLabel = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const issueLabel = String(issue).padStart(3, '0');
const href = `/newsletter/${slug}`;
---
<article class="issue-card">
  <p class="issue-card-meta">
    <span class="issue-card-num">№ {issueLabel}</span>
    <span class="dot">·</span>
    <time datetime={date.toISOString()}>{dateLabel}</time>
  </p>

  <h3 class="issue-card-title"><a href={href}>{title}</a></h3>

  <div class="issue-card-text">
    {paragraphs.map((para) => <p>{para}</p>)}
  </div>

  {/* Outside the faded container, so the button never fades with the text. */}
  <a class="issue-card-btn" href={href}>
    Read this
    <span class="issue-card-arrow" aria-hidden="true">&#8594;</span>
  </a>
</article>
