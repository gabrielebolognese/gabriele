---
/* One row of the archive. Replaces the card grid for this section: a numbered,
 * dated list carries sequence, which is the thing a publication has and a pile
 * of blog cards does not. Card.astro is untouched — the homepage still uses it.
 *
 * The whole row is one link. The cover is decorative here (alt="") because the
 * title sits right beside it and a screen reader announcing both says the same
 * thing twice.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  issue: number;
  title: string;
  description: string;
  image: ImageMetadata;
  slug: string;
  date: Date;
}

const { issue, title, description, image, slug, date } = Astro.props;

const dateLabel = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const issueLabel = String(issue).padStart(3, '0');
---
<a href={`/newsletter/${slug}`} class="issue-row">
  <div class="issue-row-rail">
    <span class="issue-row-num">№ {issueLabel}</span>
    <time class="issue-row-date" datetime={date.toISOString()}>{dateLabel}</time>
  </div>

  <div class="issue-row-body">
    <h3 class="issue-row-title">{title}</h3>
    <p class="issue-row-desc">{description}</p>
  </div>

  <div class="issue-row-thumb">
    <Image
      src={image}
      alt=""
      widths={[200, 400]}
      sizes="200px"
      loading="lazy"
      decoding="async"
    />
  </div>
</a>
