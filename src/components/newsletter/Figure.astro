---
/* A captioned image inside an issue body.
 *
 * `width` maps to the named columns of the .issue-body grid in Style.css:
 *
 *   column  680px, the text measure. The default — an image that belongs with
 *           the sentence next to it should not shout.
 *   wide    1040px, breaking ~180px past the text on each side. The workhorse
 *           for screenshots, which are unreadable at 680.
 *   full    the whole content width, edge to edge.
 *
 * Figures number themselves through a CSS counter on .issue-body, so nothing
 * here has to know its own index and inserting one mid-issue renumbers the
 * rest for free.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Rendered under the image. Distinct from alt: alt describes, caption says
   *  what it means. Omit and the figure renders uncaptioned but still numbered. */
  caption?: string;
  width?: 'column' | 'wide' | 'full';
}

const { src, alt, caption, width = 'wide' } = Astro.props;

/* Ask for roughly 2x the display width at each breakpoint so the image holds up
   on a retina screen without shipping the original. */
const WIDTHS = {
  column: [680, 1360],
  wide: [680, 1040, 2080],
  full: [860, 1280, 2400],
} as const;

const SIZES = {
  column: '(max-width: 860px) 100vw, 680px',
  wide: '(max-width: 1100px) 100vw, 1040px',
  full: '100vw',
} as const;
---
<figure class={`issue-figure fig-${width}`}>
  <Image
    src={src}
    alt={alt}
    widths={[...WIDTHS[width]]}
    sizes={SIZES[width]}
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
